-- // Scale helpers for mobile
-- On mobile we shrink the default window and hit areas so they fit the screen.
local BASE_WIDTH  = 504
local BASE_HEIGHT = 604
local function getViewport()
    return ws.CurrentCamera.ViewportSize
end
local function mobileScale()
    if not isMobile then return 1 end
    local vp = getViewport()
    -- target ≈80 % of the narrower axis, but never go above 1
    local s = math.min(vp.X, vp.Y) * 0.80 / math.min(BASE_WIDTH, BASE_HEIGHT)
    return math.min(s, 1)
end

