                if input and input.EnumType then
                    if input.EnumType==Enum.KeyCode or input.EnumType==Enum.UserInputType then
                        if table.find(allowed,input.Name) or table.find(allowedIT,input.Name) then
                            keybind.current={input.EnumType==Enum.KeyCode and "KeyCode" or "UserInputType",input.Name}
                            kb_val.Text=#keybind.current>0 and keybind:Shorten(keybind.current[2]) or "..."
                            return true
                        end
                    end
                end
                return false
            end
            function keybind:Get() return keybind.current end
            function keybind:Set(tbl) keybind.current=tbl; kb_val.Text=#keybind.current>0 and keybind:Shorten(keybind.current[2]) or "..." end
            function keybind:Active() return keybind.active end
            function keybind:Reset()
                for _,v in pairs(keybind.modemenu.buttons) do v.Color=v.Text==keybind.mode and theme.accent or theme.textcolor end
                keybind.active=keybind.mode=="Always" and true or false
                if keybind.current[1] and keybind.current[2] then kbcb(Enum[keybind.current[1]][keybind.current[2]],keybind.active) end
            end
