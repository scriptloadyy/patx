            info = info or {}
            local def         = info.def or info.Def or info.default or info.Default or nil
            local kbptr       = info.pointer or info.Pointer or info.flag or info.Flag or nil
            local mode        = info.mode or info.Mode or "Always"
            local keybindname = info.keybindname or info.keybindName or info.KeybindName or info.Keybindname or nil
            local kbcb        = info.callback or info.callBack or info.Callback or info.CallBack or function()end
            local keybind     = {keybindname=keybindname or name,axis=toggle.axis,current={},selecting=false,mode=mode,open=false,modemenu={buttons={},drawings={}},active=false}
            toggle.keybind    = keybind

            local allowed   = {"Q","W","E","R","T","Y","U","I","O","P","A","S","D","F","G","H","J","K","L","Z","X","C","V","B","N","M","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","0","Insert","Tab","Home","End","LeftAlt","LeftControl","LeftShift","RightAlt","RightControl","RightShift","CapsLock"}
            local allowedIT = {"MouseButton1","MouseButton2","MouseButton3"}
            local shortened = {["MouseButton1"]="MB1",["MouseButton2"]="MB2",["MouseButton3"]="MB3",["Insert"]="Ins",["LeftAlt"]="LAlt",["LeftControl"]="LC",["LeftShift"]="LS",["RightAlt"]="RAlt",["RightControl"]="RC",["RightShift"]="RS",["CapsLock"]="Caps"}
