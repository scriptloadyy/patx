                Size     = utility:Size(0, 150, 0, 22),
                Position = utility:Position(0, 10, 0.4, 0),
                Hidden   = true, ZIndex = 55, Color = theme.outline,
                Visible  = false
            }); window.keybindslist.outline = kbl_outline

            local kbl_inline = utility:Create("Frame", {Vector2.new(1, 1), kbl_outline}, {
                Size = utility:Size(1,-2,1,-2,kbl_outline), Position = utility:Position(0,1,0,1,kbl_outline),
                Hidden = true, ZIndex = 55, Color = theme.inline, Visible = false
            })
            local kbl_frame = utility:Create("Frame", {Vector2.new(1, 1), kbl_inline}, {
                Size = utility:Size(1,-2,1,-2,kbl_inline), Position = utility:Position(0,1,0,1,kbl_inline),
                Hidden = true, ZIndex = 55, Color = theme.light_contrast, Visible = false
            })
            local kbl_accent = utility:Create("Frame", {Vector2.new(0, 0), kbl_frame}, {
                Size = utility:Size(1,0,0,1,kbl_frame), Position = utility:Position(0,0,0,0,kbl_frame),
                Hidden = true, ZIndex = 55, Color = theme.accent, Visible = false
            })
            local kbl_title = utility:Create("TextLabel", {Vector2.new(0, 5), kbl_outline}, {
                Text = "- Keybinds -", Size = theme.textsize, Font = theme.font,
                Color = theme.textcolor, OutlineColor = theme.textborder, Center = true,
                Hidden = true, ZIndex = 55, Position = utility:Position(0.5,0,0,5,kbl_outline),
                Visible = false
            })

            function window.keybindslist:Resort()
                local index = 0
                for _, v in pairs(window.keybindslist.keybinds) do
                    v:Move(index * 17); index = index + 1
                end
            end

            function window.keybindslist:Add(kbname, kbvalue)
                if kbname and kbvalue and not window.keybindslist.keybinds[kbname] then
                    local kbT = {}
                    local kb_outline = utility:Create("Frame", {Vector2.new(0, kbl_outline.Size.Y-1), kbl_outline}, {
                        Size=utility:Size(1,0,0,18,kbl_outline), Position=utility:Position(0,0,1,-1,kbl_outline),
                        Hidden=true, ZIndex=55, Color=theme.outline, Visible=window.keybindslist.visible
                    })
                    local kb_inline = utility:Create("Frame", {Vector2.new(1,1),kb_outline},{Size=utility:Size(1,-2,1,-2,kb_outline),Position=utility:Position(0,1,0,1,kb_outline),Hidden=true,ZIndex=55,Color=theme.inline,Visible=window.keybindslist.visible})
                    local kb_frame  = utility:Create("Frame", {Vector2.new(1,1),kb_inline}, {Size=utility:Size(1,-2,1,-2,kb_inline), Position=utility:Position(0,1,0,1,kb_inline), Hidden=true,ZIndex=55,Color=theme.dark_contrast,Visible=window.keybindslist.visible})
                    local kb_ttl    = utility:Create("TextLabel",{Vector2.new(4,3),kb_outline},{Text=kbname,Size=theme.textsize,Font=theme.font,Color=theme.textcolor,OutlineColor=theme.textborder,Center=false,Hidden=true,ZIndex=55,Position=utility:Position(0,4,0,3,kb_outline),Visible=window.keybindslist.visible})
                    local kb_val    = utility:Create("TextLabel",{Vector2.new(0,3),kb_outline},{Text="["..kbvalue.."]",Size=theme.textsize,Font=theme.font,Color=theme.textcolor,OutlineColor=theme.textborder,Hidden=true,ZIndex=55,Position=utility:Position(1,-4-utility:GetTextBounds(kbvalue,theme.textsize,theme.font).X,0,3,kb_outline),Visible=window.keybindslist.visible})

                    function kbT:Move(yPos)
                        kb_outline.Position = utility:Position(0,0,1,-1+yPos,kbl_outline)
                        kb_inline.Position  = utility:Position(0,1,0,1,kb_outline)
                        kb_frame.Position   = utility:Position(0,1,0,1,kb_inline)
                        kb_ttl.Position     = utility:Position(0,4,0,3,kb_outline)
                        kb_val.Position     = utility:Position(1,-4-kb_val.TextBounds.X,0,3,kb_outline)
                    end
                    function kbT:Remove()
                        utility:Remove(kb_outline,true); utility:Remove(kb_inline,true)
                        utility:Remove(kb_frame,true);  utility:Remove(kb_ttl,true); utility:Remove(kb_val,true)
                        window.keybindslist.keybinds[kbname] = nil; kbT = nil
                    end
                    function kbT:Visibility()
                        local vis = window.keybindslist.visible
                        kb_outline.Visible=vis; kb_inline.Visible=vis; kb_frame.Visible=vis
                        kb_ttl.Visible=vis; kb_val.Visible=vis
                    end

                    window.keybindslist.keybinds[kbname] = kbT
                    window.keybindslist:Resort()
                end
            end

            function window.keybindslist:Remove(kbname)
                if kbname and window.keybindslist.keybinds[kbname] then
                    window.keybindslist.keybinds[kbname]:Remove()
                    window.keybindslist:Resort()
                end
            end

            function window.keybindslist:Visibility()
                local vis = window.keybindslist.visible
                kbl_outline.Visible=vis; kbl_inline.Visible=vis; kbl_frame.Visible=vis
                kbl_accent.Visible=vis;  kbl_title.Visible=vis
                for _, v in pairs(window.keybindslist.keybinds) do v:Visibility() end
            end

            function window.keybindslist:Update(updateType, updateValue)
                if updateType == "Visible" then
                    window.keybindslist.visible = updateValue
                    window.keybindslist:Visibility()
                end
            end

            utility:Connection(ws.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function()
                kbl_outline.Position = utility:Position(0,10,0.4,0)
                kbl_inline.Position  = utility:Position(0,1,0,1,kbl_outline)
                kbl_frame.Position   = utility:Position(0,1,0,1,kbl_inline)
                kbl_accent.Position  = utility:Position(0,0,0,0,kbl_frame)
                kbl_title.Position   = utility:Position(0.5,0,0,5,kbl_outline)
                window.keybindslist:Resort()
            end)
        end

        -------------------------------------------------------
        -- On mobile we skip the custom cursor (no mouse pointer)
        function window:Cursor(info)
            window.cursor = {cursor = nil, cursor_inline = nil}
            if isMobile then return window.cursor end

            local cursor = utility:Create("Triangle", nil, {
                Color=theme.cursoroutline, Thickness=2.5, Filled=false, ZIndex=65, Hidden=true
            }); window.cursor.cursor = cursor

            local cursor_inline = utility:Create("Triangle", nil, {
                Color=theme.accent, Filled=true, Thickness=0, ZIndex=65, Hidden=true
            }); window.cursor.cursor_inline = cursor_inline

            utility:Connection(rs.RenderStepped, function()
                local ml = utility:MouseLocation()
                cursor.PointA       = Vector2.new(ml.X, ml.Y)
                cursor.PointB       = Vector2.new(ml.X + 16, ml.Y + 6)
                cursor.PointC       = Vector2.new(ml.X + 6, ml.Y + 16)
                cursor_inline.PointA = Vector2.new(ml.X, ml.Y)
                cursor_inline.PointB = Vector2.new(ml.X + 16, ml.Y + 6)
                cursor_inline.PointC = Vector2.new(ml.X + 6, ml.Y + 16)
            end)

            uis.MouseIconEnabled = false
            return window.cursor
        end

        function window:Fade()
            window.fading    = true
            window.isVisible = not window.isVisible

            spawn(function()
                for _, v in pairs(library.drawings) do
                    utility:Lerp(v[1], {Transparency = window.isVisible and v[3] or 0}, 0.25)
                end
            end)

            if window.cursor then
                if window.cursor.cursor then
                    window.cursor.cursor.Transparency       = window.isVisible and 1 or 0
                end
                if window.cursor.cursor_inline then
                    window.cursor.cursor_inline.Transparency = window.isVisible and 1 or 0
                end
            end

            if not isMobile then
                uis.MouseIconEnabled = not window.isVisible
            end

            window.fading = false
        end

        function window:Initialize()
            window.pages[1]:Show()
            for _, v in pairs(window.pages) do v:Update() end
            library.shared.initialized = true
            window:Watermark()
            window:KeybindsList()
            window:Cursor()
            window:Fade()
        end

        -------------------------------------------------------
        -- Input: drag the window (supports touch drag on mobile)
        library.began[#library.began + 1] = function(Input)
            if isClick(Input) and window.isVisible then
                local ml = utility:MouseLocation()
                local dragZoneH = isMobile and 28 or 20
                if utility:MouseOverDrawing({main_frame.Position.X, main_frame.Position.Y,
                    main_frame.Position.X + main_frame.Size.X, main_frame.Position.Y + dragZoneH}) then
                    window.dragging = true
                    window.drag     = Vector2.new(ml.X - main_frame.Position.X, ml.Y - main_frame.Position.Y)
                end
            end
        end

        library.ended[#library.ended + 1] = function(Input)
            if isRelease(Input) and window.isVisible and window.dragging then
                window.dragging = false
                window.drag     = Vector2.new(0, 0)
            end
        end

        library.changed[#library.changed + 1] = function(Input)
            if window.dragging and window.isVisible then
                local ml  = utility:MouseLocation()
                local scr = utility:GetScreenSize()
                local mx  = math.clamp(ml.X - window.drag.X, 5, scr.X - main_frame.Size.X - 5)
                local my  = math.clamp(ml.Y - window.drag.Y, 5, scr.Y - main_frame.Size.Y - 5)
                window:Move(Vector2.new(mx, my))
            end
        end

        -- Toggle visibility: keyboard on PC, double-tap on mobile
        library.began[#library.began + 1] = function(Input)
            if Input.KeyCode == window.uibind then
                window:Fade()
            end
        end

        -- Double-tap detection for mobile toggle
        if isMobile then
            local lastTap = 0
            utility:Connection(uis.TouchTapInWorld, function(pos, processed)
                if processed then return end
                local now = tick()
                if now - lastTap < 0.3 then
                    window:Fade()
                    lastTap = 0
                else
                    lastTap = now
                end
            end)
        end

        -------------------------------------------------------
        utility:Connection(uis.InputBegan, function(Input)
            for _, func in pairs(library.began) do
                if not window.dragging then
                    pcall(func, Input)
                else
                    break
                end
            end
        end)

        utility:Connection(uis.InputEnded, function(Input)
            for _, func in pairs(library.ended) do pcall(func, Input) end
        end)

        -- InputChanged fires on mouse/touch move
        utility:Connection(uis.InputChanged, function(Input)
            -- Update touchPosition from InputChanged too (more reliable than TouchMoved alone)
            if Input.UserInputType == Enum.UserInputType.Touch then
                touchPosition = Vector2.new(Input.Position.X, Input.Position.Y)
            end
            for _, func in pairs(library.changed) do pcall(func, Input) end
        end)

        utility:Connection(ws.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function()
            local nvp = getViewport()
            window:Move(Vector2.new(nvp.X / 2 - size.X / 2, nvp.Y / 2 - size.Y / 2))
        end)

        return setmetatable(window, library)
    end

    -------------------------------------------------------
    function library:Page(info)
        info = info or {}
        local name   = info.name or info.Name or info.title or info.Title or "New Page"
        local window = self
        local page   = {open = false, sections = {}, sectionOffset = {left = 0, right = 0}, window = window}

        local position = 4
        for _, v in pairs(window.pages) do
            position = position + (v.page_button.Size.X + 2)
        end

        local textbounds = utility:GetTextBounds(name, theme.textsize, theme.font)

        local page_button = utility:Create("Frame", {Vector2.new(position, 4), window.back_frame}, {
            Size     = utility:Size(0, textbounds.X + 20, 0, 21),
            Position = utility:Position(0, position, 0, 4, window.back_frame),
            Color    = theme.outline
        }); page["page_button"] = page_button

        local page_button_inline = utility:Create("Frame", {Vector2.new(1, 1), page_button}, {
            Size  = utility:Size(1,-2,1,-1,page_button),
            Position = utility:Position(0,1,0,1,page_button), Color = theme.inline
        }); page["page_button_inline"] = page_button_inline

        local page_button_color = utility:Create("Frame", {Vector2.new(1,1), page_button_inline}, {
            Size  = utility:Size(1,-2,1,-1,page_button_inline),
            Position = utility:Position(0,1,0,1,page_button_inline), Color = theme.dark_contrast
        }); page["page_button_color"] = page_button_color

        local page_button_title = utility:Create("TextLabel", {Vector2.new(0, 2), page_button_color}, {
            Text = name, Size = theme.textsize, Font = theme.font,
            Color = theme.textcolor, Center = true, OutlineColor = theme.textborder,
            Position = utility:Position(0.5, 0, 0, 2, page_button_color)
        })

        window.pages[#window.pages + 1] = page

        function page:Update()
            page.sectionOffset["left"]  = 0
            page.sectionOffset["right"] = 0
            for _, v in pairs(page.sections) do
                utility:UpdateOffset(v.section_inline, {Vector2.new(
                    v.side == "right" and (window.tab_frame.Size.X/2)+2 or 5,
                    5 + page["sectionOffset"][v.side]
                ), window.tab_frame})
                page.sectionOffset[v.side] = page.sectionOffset[v.side] + v.section_inline.Size.Y + 5
            end
            window:Move(window.main_frame.Position)
        end

        function page:Show()
            if window.currentPage then
                window.currentPage.page_button_color.Size  = utility:Size(1,-2,1,-1,window.currentPage.page_button_inline)
                window.currentPage.page_button_color.Color = theme.dark_contrast
                window.currentPage.open = false
                for _, v in pairs(window.currentPage.sections) do
                    for _, x in pairs(v.visibleContent) do x.Visible = false end
                end
                window:CloseContent()
            end
            window.currentPage = page
            page_button_color.Size  = utility:Size(1,-2,1,0,page_button_inline)
            page_button_color.Color = theme.light_contrast
            page.open = true
            for _, v in pairs(page.sections) do
                for _, x in pairs(v.visibleContent) do x.Visible = true end
            end
        end

        library.began[#library.began + 1] = function(Input)
            if isClick(Input) and window.isVisible
               and utility:MouseOverDrawing({page_button.Position.X, page_button.Position.Y,
                   page_button.Position.X + page_button.Size.X, page_button.Position.Y + page_button.Size.Y})
               and window.currentPage ~= page then
                page:Show()
            end
        end

        return setmetatable(page, pages)
    end

