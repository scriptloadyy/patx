                    if v[1] and v[1].Remove then pcall(function() v[1]:Remove() end) end
                end)()
            end
            for _, v in pairs(library.drawings) do
                coroutine.wrap(function()
                    if v[1] then pcall(function() v[1]:Remove() end) end
                end)()
            end
            library.drawings = {}; library.hidden = {}; library.connections = {}
            library.began = {}; library.ended = {}; library.changed = {}
            uis.MouseIconEnabled = true
