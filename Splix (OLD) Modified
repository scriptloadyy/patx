    function pages:MultiSection(info)
        info = info or {}
        local msections = info.sections or info.Sections or {}
        local side      = (info.side or info.Side or "left"):lower()
        local sz        = info.size or info.Size or 150
        local window    = self.window
        local page      = self
        local MS = {window=window,page=page,sections={},backup={},visibleContent={},currentSection=nil,xAxis=0,side=side}

        local ms_inline = utility:Create("Frame",
            {Vector2.new(side=="right" and (window.tab_frame.Size.X/2)+2 or 5, 5+page["sectionOffset"][side]), window.tab_frame},
            {Size=utility:Size(0.5,-7,0,sz,window.tab_frame),
             Position=utility:Position(side=="right" and 0.5 or 0,side=="right" and 2 or 5,0,5+page.sectionOffset[side],window.tab_frame),
             Color=theme.inline,Visible=page.open
        }, MS.visibleContent); MS["section_inline"] = ms_inline

        local ms_outline = utility:Create("Frame",{Vector2.new(1,1),ms_inline},{Size=utility:Size(1,-2,1,-2,ms_inline),Position=utility:Position(0,1,0,1,ms_inline),Color=theme.outline,Visible=page.open},MS.visibleContent); MS["section_outline"]=ms_outline
        local ms_frame   = utility:Create("Frame",{Vector2.new(1,1),ms_outline},{Size=utility:Size(1,-2,1,-2,ms_outline),Position=utility:Position(0,1,0,1,ms_outline),Color=theme.dark_contrast,Visible=page.open},MS.visibleContent); MS["section_frame"]=ms_frame
        local ms_bkFrame = utility:Create("Frame",{Vector2.new(0,2),ms_frame},{Size=utility:Size(1,0,0,17,ms_frame),Position=utility:Position(0,0,0,2,ms_frame),Color=theme.light_contrast,Visible=page.open},MS.visibleContent)
        local ms_botLine = utility:Create("Frame",{Vector2.new(0,ms_bkFrame.Size.Y-1),ms_bkFrame},{Size=utility:Size(1,0,0,1,ms_bkFrame),Position=utility:Position(0,0,1,-1,ms_bkFrame),Color=theme.outline,Visible=page.open},MS.visibleContent)
        local ms_accent  = utility:Create("Frame",{Vector2.new(0,0),ms_frame},{Size=utility:Size(1,0,0,2,ms_frame),Position=utility:Position(0,0,0,0,ms_frame),Color=theme.accent,Visible=page.open},MS.visibleContent); MS["section_accent"]=ms_accent

        for i, v in pairs(msections) do
            local msec = {window=window,page=page,currentAxis=24,sections={},visibleContent={},section_inline=ms_inline,section_outline=ms_outline,section_frame=ms_frame,section_accent=ms_accent}
            local tb   = utility:GetTextBounds(v, theme.textsize, theme.font)

            local msec_frame   = utility:Create("Frame",{Vector2.new(MS.xAxis,0),ms_bkFrame},{Size=utility:Size(0,tb.X+14,1,-1,ms_bkFrame),Position=utility:Position(0,MS.xAxis,0,0,ms_bkFrame),Color=i==1 and theme.dark_contrast or theme.light_contrast,Visible=page.open},MS.visibleContent); msec["msection_frame"]=msec_frame
            local msec_line    = utility:Create("Frame",{Vector2.new(msec_frame.Size.X,0),msec_frame},{Size=utility:Size(0,1,1,0,msec_frame),Position=utility:Position(1,0,0,0,msec_frame),Color=theme.outline,Visible=page.open},MS.visibleContent)
            local msec_title   = utility:Create("TextLabel",{Vector2.new(0,1),msec_frame},{Text=v,Size=theme.textsize,Font=theme.font,Color=theme.textcolor,OutlineColor=theme.textborder,Center=true,Position=utility:Position(0.5,0,0,1,msec_frame),Visible=page.open},MS.visibleContent)
            local msec_botline = utility:Create("Frame",{Vector2.new(0,msec_frame.Size.Y),msec_frame},{Size=utility:Size(1,0,0,1,msec_frame),Position=utility:Position(0,0,1,0,msec_frame),Color=i==1 and theme.dark_contrast or theme.outline,Visible=page.open},MS.visibleContent); msec["msection_bottomline"]=msec_botline

            function msec:Update()
                if MS.currentSection == msec then
                    MS.visibleContent = utility:Combine(MS.backup, MS.currentSection.visibleContent)
                else
                    for _, x in pairs(msec.visibleContent) do x.Visible = false end
                end
            end

            library.began[#library.began + 1] = function(Input)
                if isClick(Input) and window.isVisible and page.open
                   and utility:MouseOverDrawing({msec_frame.Position.X,msec_frame.Position.Y,msec_frame.Position.X+msec_frame.Size.X,msec_frame.Position.Y+msec_frame.Size.Y})
                   and MS.currentSection ~= msec and not window:IsOverContent() then
                    MS.currentSection.msection_frame.Color      = theme.light_contrast
                    MS.currentSection.msection_bottomline.Color = theme.outline
                    for _, x in pairs(MS.currentSection.visibleContent) do x.Visible = false end
                    MS.currentSection = msec
                    msec_frame.Color  = theme.dark_contrast
                    msec_botline.Color = theme.dark_contrast
                    for _, x in pairs(MS.currentSection.visibleContent) do x.Visible = true end
                    MS.visibleContent = utility:Combine(MS.backup, MS.currentSection.visibleContent)
                end
            end

            if i == 1 then MS.currentSection = msec end
            MS.sections[#MS.sections + 1] = setmetatable(msec, sections)
            MS.xAxis = MS.xAxis + tb.X + 15
        end

        for z, x in pairs(MS.visibleContent) do MS.backup[z] = x end
        page.sectionOffset[side] = page.sectionOffset[side] + 100 + 5
        page.sections[#page.sections + 1] = MS
        return table.unpack(MS.sections)
    end

