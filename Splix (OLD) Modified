            if window.currentContent.dropdown and window.currentContent.dropdown.open then
                local dd = window.currentContent.dropdown
                dd.open = false
                utility:LoadImage(dd.dropdown_image, "arrow_down", "https://i.imgur.com/tVqy0nL.png")
